# Copy to .env and set real values:  cp .env.example .env
# .env is gitignored — never commit it. The app itself runs with NO .env (mock LLM mode);
# the DB_PASSWORD / MYSQL_ROOT_PASSWORD below are only needed for `docker compose up`.

# --- Database secrets (required for docker compose; local synthetic DB only) -----------------
# `docker compose up` fails fast if these are unset — no default passwords baked into the repo.
MYSQL_ROOT_PASSWORD=change-me-root       # admin password for the local demo MySQL
DB_PASSWORD=change-me-readonly           # password for the SELECT-only app user (llm_readonly)

# --- Database connection (non-secret; defaults match the synthetic demo) ---------------------
DB_HOST=127.0.0.1                        # in docker compose the app overrides this to "mysql"
DB_PORT=3306
DB_USER=llm_readonly
DB_NAME=dyrtransportes

# --- LLM -------------------------------------------------------------------------------------
# mock  = deterministic, no API key, no network (default)
# openai = call an OpenAI-compatible endpoint (cloud or self-hosted vLLM, etc.)
LLM_MODE=mock
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed
LLM_MODEL=gpt-4o-mini
# Optional: USD per 1M tokens, for cost estimation (leave 0 if unknown → cost shows as $0).
LLM_PRICE_INPUT_PER_1M=0.0
LLM_PRICE_OUTPUT_PER_1M=0.0

# --- Safety / agent limits -------------------------------------------------------------------
RESULT_LIMIT=500
AGENT_MAX_ITERATIONS=6

# --- RAG store -------------------------------------------------------------------------------
CHROMA_PATH=.chroma
