# Copy to .env and adjust. Every value has a safe default — the app runs with NO .env at all
# (mock LLM mode). Never commit a real .env (it is gitignored).

# --- LLM ---------------------------------------------------------------------
# mock  = deterministic, no API key, no network (default)
# openai = call an OpenAI-compatible endpoint (cloud or self-hosted vLLM, etc.)
LLM_MODE=mock
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed
LLM_MODEL=gpt-4o-mini

# --- Query-target database (synthetic DYR Transportes; wired in task 0002) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=llm_readonly
DB_PASSWORD=
DB_NAME=dyrtransportes

# --- Safety / agent limits ---------------------------------------------------
RESULT_LIMIT=500
AGENT_MAX_ITERATIONS=6

# --- RAG store ---------------------------------------------------------------
CHROMA_PATH=.chroma
