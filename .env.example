# cp .env.example .env, then set the change-me values. Gitignored; never commit .env.
# Uncommented values = local host dev. For prod compose, use the "# prod:" variants.

# --- Deploy + LLM ---
DEPLOY_MODE=demo                          # demo | live
LLM_MODE=mock                             # mock | openai
LLM_BASE_URL=http://localhost:8000/v1     # prod: http://10.0.0.5:8000/v1 (container can't reach localhost)
LLM_API_KEY=not-needed
LLM_MODEL=gpt-4o-mini
LLM_PRICE_INPUT_PER_1M=0.0
LLM_PRICE_OUTPUT_PER_1M=0.0

# --- Query DB (read-only MySQL the assistant reads) ---
QUERY_DB_HOST=localhost                   # prod: mysql
QUERY_DB_PORT=3306
QUERY_DB_NAME=dyrtransportes
QUERY_DB_USER=llm_readonly
QUERY_DB_PASSWORD=change-me-readonly
QUERY_DB_ROOT_PASSWORD=change-me-root     # compose only: Flyway seeds the mock DB with this

# --- App store (Postgres: users, conversations, feedback) ---
APP_DB_HOST=localhost                     # prod: postgres
APP_DB_PORT=5432
APP_DB_USER=app
APP_DB_PASSWORD=change-me-app
APP_DB_NAME=dyr_app

# --- Auth ---
JWT_SECRET=change-me-min-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRY_MIN=1440

# --- Rate limit (per user; overrides DEPLOY_MODE defaults) ---
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_PER_DAY=0

# --- Safety / agent ---
RESULT_LIMIT=500
AGENT_MAX_ITERATIONS=6
STATEMENT_TIMEOUT_MS=5000

# --- Web ---
WEB_PORT=80                               # nginx published port (prod compose)
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173
