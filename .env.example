# Copy to .env and set real values:  cp .env.example .env
# .env is gitignored — never commit it. The app reads .env automatically (python-dotenv), and
# docker compose reads it for ${VAR} interpolation. Every var has a code default (app/config.py),
# so you only need to change the secrets marked "change-me" and anything host-specific.
#
# Two ways the same .env is used:
#   • Running the app on your host (uvicorn/alembic): every var below is read directly.
#   • docker compose: uses its OWN internal networking for DB_HOST / APP_DATABASE_URL (service names),
#     so those two are ignored there — compose only pulls the *secrets* + DEPLOY_MODE / LLM_MODE / WEB_PORT.

# --- Deploy flavor + LLM ---------------------------------------------------------------------
# demo = mock LLM, generous limits (safe to leave open).  live = real LLM + strict limits + daily cap.
DEPLOY_MODE=demo
# mock = deterministic, no API key, no network (default).  openai = an OpenAI-compatible endpoint.
LLM_MODE=mock
LLM_BASE_URL=http://localhost:11434/v1   # e.g. Ollama; only used when LLM_MODE=openai
LLM_API_KEY=not-needed                   # any placeholder for Ollama; real key for a cloud endpoint
LLM_MODEL=gpt-4o-mini
# Optional USD per 1M tokens for cost estimation (0 = unknown → cost shows as $0).
LLM_PRICE_INPUT_PER_1M=0.0
LLM_PRICE_OUTPUT_PER_1M=0.0

# --- Query database (synthetic DYR Transportes MySQL) ----------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root       # admin password for the local demo MySQL (compose init)
DB_PASSWORD=change-me-readonly           # password for the SELECT-only app user (llm_readonly)
DB_HOST=127.0.0.1                        # host-run value; docker compose overrides this to "mysql"
DB_PORT=3306
DB_USER=llm_readonly
DB_NAME=dyrtransportes

# --- App datastore (Postgres: users / conversations / messages / feedback) -------------------
APP_DB_PASSWORD=change-me-postgres       # password for the `app` Postgres user (used by docker compose)
# Host-run DSN (async). Keep the password in sync with APP_DB_PASSWORD. If port 5432 is taken on your
# machine, run Postgres on another port and change it here (e.g. ...@localhost:55432/dyr_app).
APP_DATABASE_URL=postgresql+asyncpg://app:change-me-postgres@localhost:5432/dyr_app

# --- Auth (JWT) ------------------------------------------------------------------------------
# MUST be >=32 bytes and unique per deploy. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRY_MIN=1440                      # token lifetime in minutes (default 1 day)

# --- Rate limiting (per user, on /chat) — overrides the DEPLOY_MODE defaults if set ----------
# demo defaults: 60/min, no daily cap.  live defaults: 20/min + 100/day.  0 daily = no cap.
# RATE_LIMIT_PER_MIN=60
# RATE_LIMIT_PER_DAY=0

# --- Safety / agent limits -------------------------------------------------------------------
RESULT_LIMIT=500
AGENT_MAX_ITERATIONS=6
STATEMENT_TIMEOUT_MS=5000

# --- RAG store + CORS ------------------------------------------------------------------------
CHROMA_PATH=.chroma
# Comma-separated allowed origins for the API (Vite dev + preview by default).
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Production web (docker-compose.prod.yml only) -------------------------------------------
WEB_PORT=80                              # published port for nginx; set 8080 if 80 is taken
